# Copy this file to `.env` and fill in your bot token.
# Get a token at https://discord.com/developers/applications -> New Application -> Bot.
DISCORD_TOKEN=your-bot-token-here

# Optional: log verbosity. INFO (default) = one line per action;
# DEBUG = every API request, jacket fetch and link lookup.
# LOG_LEVEL=INFO

# Optional: instantly sync slash commands to this server (global sync can take
# up to ~1h to appear). Your server ID: right-click server -> Copy Server ID.
# GUILD_ID=328220111024553984
